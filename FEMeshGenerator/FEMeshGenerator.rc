IDD_FEMESHGENERATOR_DIALOG DIALOGEX 0, 0, 620, 420
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "T型焊接结构有限元网格自动划分程序 - FEMeshGenerator"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    // 左侧OpenGL视图区域在代码中动态创建
    
    // 右侧参数面板 (从x=420开始)
    GROUPBOX        "几何参数 (mm)",IDC_STATIC,425,5,190,110
    LTEXT           "L1 (长度1):",IDC_STATIC,435,20,50,8
    EDITTEXT        IDC_EDIT_L1,495,18,55,14,ES_AUTOHSCROLL
    LTEXT           "L2 (长度2):",IDC_STATIC,435,38,50,8
    EDITTEXT        IDC_EDIT_L2,495,36,55,14,ES_AUTOHSCROLL
    LTEXT           "W1 (宽度1):",IDC_STATIC,435,56,50,8
    EDITTEXT        IDC_EDIT_W1,495,54,55,14,ES_AUTOHSCROLL
    LTEXT           "W2 (宽度2):",IDC_STATIC,435,74,50,8
    EDITTEXT        IDC_EDIT_W2,495,72,55,14,ES_AUTOHSCROLL
    
    LTEXT           "t1 (厚度1):",IDC_STATIC,560,20,45,8
    EDITTEXT        IDC_EDIT_T1,560,18,45,14,ES_AUTOHSCROLL
    LTEXT           "t2 (厚度2):",IDC_STATIC,560,38,45,8
    EDITTEXT        IDC_EDIT_T2,560,36,45,14,ES_AUTOHSCROLL
    LTEXT           "t3 (过渡):",IDC_STATIC,560,56,45,8
    EDITTEXT        IDC_EDIT_T3,560,54,45,14,ES_AUTOHSCROLL
    
    LTEXT           "R (半径):",IDC_STATIC,435,92,50,8
    EDITTEXT        IDC_EDIT_R,495,90,55,14,ES_AUTOHSCROLL
    LTEXT           "d (距离):",IDC_STATIC,560,92,45,8
    EDITTEXT        IDC_EDIT_D,560,90,45,14,ES_AUTOHSCROLL
    
    GROUPBOX        "焊缝参数 (mm)",IDC_STATIC,425,120,190,75
    LTEXT           "HW (高度):",IDC_STATIC,435,135,50,8
    EDITTEXT        IDC_EDIT_HW,495,133,55,14,ES_AUTOHSCROLL
    LTEXT           "LW (长度):",IDC_STATIC,435,153,50,8
    EDITTEXT        IDC_EDIT_LW,495,151,55,14,ES_AUTOHSCROLL
    LTEXT           "k (幂系数):",IDC_STATIC,435,171,50,8
    EDITTEXT        IDC_EDIT_K,495,169,55,14,ES_AUTOHSCROLL
    CONTROL         "双边焊缝",IDC_CHECK_DOUBLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,560,135,50,10
    
    GROUPBOX        "网格密度 (mm)",IDC_STATIC,425,200,190,60
    LTEXT           "焊缝区:",IDC_STATIC,435,215,50,8
    EDITTEXT        IDC_EDIT_WELD_DENSITY,495,213,55,14,ES_AUTOHSCROLL
    LTEXT           "过渡区:",IDC_STATIC,435,233,50,8
    EDITTEXT        IDC_EDIT_TRANS_DENSITY,495,231,55,14,ES_AUTOHSCROLL
    LTEXT           "平板区:",IDC_STATIC,435,251,50,8
    EDITTEXT        IDC_EDIT_PLATE_DENSITY,495,249,55,14,ES_AUTOHSCROLL
    
    GROUPBOX        "文件设置",IDC_STATIC,425,265,190,60
    LTEXT           "模板文件:",IDC_STATIC,435,280,40,8
    EDITTEXT        IDC_EDIT_TEMPLATE,480,278,90,14,ES_AUTOHSCROLL
    PUSHBUTTON      "浏览...",IDC_BTN_BROWSE,575,278,35,14
    LTEXT           "输出文件:",IDC_STATIC,435,300,40,8
    EDITTEXT        IDC_EDIT_OUTPUT,480,298,125,14,ES_AUTOHSCROLL
    
    PUSHBUTTON      "生成网格",IDC_BTN_GENERATE,430,335,80,25
    PUSHBUTTON      "导出INP",IDC_BTN_EXPORT,520,335,80,25
    PUSHBUTTON      "加载模板",IDC_BTN_LOAD_TEMPLATE,430,365,80,25
